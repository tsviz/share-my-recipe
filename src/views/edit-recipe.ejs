<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Recipe</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px 0;
        }
        .recipe-form-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            padding: 40px;
            max-width: 800px;
            margin: 0 auto;
        }
        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #667eea;
        }
        .section-icon {
            width: 35px;
            height: 35px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #495057;
            margin: 0;
        }
        .form-section {
            background: #f8f9ff;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
        }
        .time-input-group {
            display: flex;
            gap: 15px;
        }
        .time-input-wrapper {
            flex: 1;
        }
        .difficulty-options {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .difficulty-option {
            flex: 1;
            min-width: 120px;
        }
        .difficulty-option input[type="radio"] {
            display: none;
        }
        .difficulty-label {
            display: block;
            padding: 12px 20px;
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }
        .difficulty-option input[type="radio"]:checked + .difficulty-label {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: #667eea;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }
        .difficulty-label:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        .btn-submit {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.3);
        }
        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(102, 126, 234, 0.5);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="recipe-form-container">
            <div class="text-center mb-4">
                <h1 class="mb-2" style="color: #667eea; font-weight: 700;">
                    <i class="bi bi-pencil-square"></i> Edit Recipe
                </h1>
                <p class="text-muted">Update your recipe details</p>
            </div>

            <form action="/recipes/edit/<%= recipe.id %>" method="POST">
                <!-- Basic Information Section -->
                <div class="form-section">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>
                        <h2 class="section-title">Basic Information</h2>
                    </div>
                    
                    <div class="mb-3">
                        <label for="title" class="form-label fw-bold">
                            <i class="bi bi-card-heading"></i> Recipe Title *
                        </label>
                        <input type="text" class="form-control" id="title" name="title" 
                               value="<%= recipe.title %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label fw-bold">
                            <i class="bi bi-text-paragraph"></i> Description
                        </label>
                        <textarea class="form-control" id="description" name="description" rows="3"><%= recipe.description || '' %></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="cuisine" class="form-label fw-bold">
                                <i class="bi bi-globe"></i> Cuisine *
                            </label>
                            <select class="form-select" id="cuisine" name="cuisine" required>
                                <option value="">Select a cuisine</option>
                                <% if (cuisines) { cuisines.forEach(cui => { %>
                                    <option value="<%= cui %>" <%= recipe.cuisine === cui ? 'selected' : '' %>><%= cui %></option>
                                <% }) } %>
                            </select>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="servings" class="form-label fw-bold">
                                <i class="bi bi-people"></i> Servings
                            </label>
                            <input type="number" class="form-control" id="servings" name="servings" 
                                   min="1" max="100" value="<%= recipe.servings || '' %>">
                        </div>
                    </div>
                </div>

                <!-- Time & Difficulty Section -->
                <div class="form-section">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-clock"></i>
                        </div>
                        <h2 class="section-title">Time & Difficulty</h2>
                    </div>
                    
                    <div class="time-input-group mb-3">
                        <div class="time-input-wrapper">
                            <label for="prep_time_minutes" class="form-label fw-bold">
                                <i class="bi bi-hourglass-split"></i> Prep Time (min)
                            </label>
                            <input type="number" class="form-control" id="prep_time_minutes" 
                                   name="prep_time_minutes" min="0" value="<%= recipe.prep_time_minutes || '' %>">
                        </div>
                        
                        <div class="time-input-wrapper">
                            <label for="cook_time_minutes" class="form-label fw-bold">
                                <i class="bi bi-fire"></i> Cook Time (min)
                            </label>
                            <input type="number" class="form-control" id="cook_time_minutes" 
                                   name="cook_time_minutes" min="0" value="<%= recipe.cook_time_minutes || '' %>">
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-signal"></i> Difficulty Level
                        </label>
                        <div class="difficulty-options">
                            <div class="difficulty-option">
                                <input type="radio" id="difficulty-easy" name="difficulty" value="Easy" 
                                       <%= recipe.difficulty === 'Easy' ? 'checked' : '' %>>
                                <label class="difficulty-label" for="difficulty-easy">
                                    😊 Easy
                                </label>
                            </div>
                            <div class="difficulty-option">
                                <input type="radio" id="difficulty-medium" name="difficulty" value="Medium"
                                       <%= recipe.difficulty === 'Medium' ? 'checked' : '' %>>
                                <label class="difficulty-label" for="difficulty-medium">
                                    👨‍🍳 Medium
                                </label>
                            </div>
                            <div class="difficulty-option">
                                <input type="radio" id="difficulty-hard" name="difficulty" value="Hard"
                                       <%= recipe.difficulty === 'Hard' ? 'checked' : '' %>>
                                <label class="difficulty-label" for="difficulty-hard">
                                    👨‍🔬 Hard
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Instructions Section -->
                <div class="form-section">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-list-ol"></i>
                        </div>
                        <h2 class="section-title">Cooking Instructions</h2>
                    </div>
                    
                    <div class="mb-3">
                        <label for="instructions" class="form-label fw-bold">
                            <i class="bi bi-pencil-square"></i> Step-by-step Instructions
                        </label>
                        <textarea class="form-control" id="instructions" name="instructions" rows="8"><%= recipe.instructions || '' %></textarea>
                        <small class="text-muted">Write each step on a new line or number them</small>
                    </div>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-submit">
                        <i class="bi bi-check-circle"></i> Update Recipe
                    </button>
                </div>
            </form>
            
            <div class="text-center mt-4">
                <a href="/dashboard" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>
                
                <!-- Delete Recipe Button -->
                <form action="/recipes/delete/<%= recipe.id %>" method="POST" class="d-inline">
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal">
                        <i class="bi bi-trash"></i> Delete Recipe
                    </button>
                    
                    <!-- Delete Confirmation Modal -->
                    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="deleteConfirmModalLabel">Confirm Delete</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Are you sure you want to delete "<%= recipe.title %>"? This action cannot be undone.
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Delete Recipe</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
