<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px 0;
        }
        .recipe-form-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            padding: 40px;
            max-width: 800px;
            margin: 0 auto;
        }
        .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #667eea;
        }
        .section-icon {
            width: 35px;
            height: 35px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #495057;
            margin: 0;
        }
        .form-section {
            background: #f8f9ff;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
        }
        .ingredient-item {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
            animation: slideIn 0.3s ease-out;
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        .btn-add-ingredient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        .btn-add-ingredient:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }
        .btn-remove-ingredient {
            background: #dc3545;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 8px;
        }
        .time-input-group {
            display: flex;
            gap: 15px;
        }
        .time-input-wrapper {
            flex: 1;
        }
        .difficulty-options {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .difficulty-option {
            flex: 1;
            min-width: 120px;
        }
        .difficulty-option input[type="radio"] {
            display: none;
        }
        .difficulty-label {
            display: block;
            padding: 12px 20px;
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }
        .difficulty-option input[type="radio"]:checked + .difficulty-label {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: #667eea;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }
        .difficulty-label:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        .btn-submit {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.3);
        }
        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(102, 126, 234, 0.5);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="recipe-form-container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success">
                    <%= messages.success %>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger">
                    <%= messages.error %>
                </div>
            <% } %>
            
            <div class="text-center mb-4">
                <h1 class="mb-2" style="color: #667eea; font-weight: 700;">
                    <i class="bi bi-plus-circle-fill"></i> Create New Recipe
                </h1>
                <p class="text-muted">Share your culinary masterpiece with the community</p>
            </div>

            <form action="/recipes" method="POST" id="recipeForm">
                <!-- Basic Information Section -->
                <div class="form-section">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>
                        <h2 class="section-title">Basic Information</h2>
                    </div>
                    
                    <div class="mb-3">
                        <label for="title" class="form-label fw-bold">
                            <i class="bi bi-card-heading"></i> Recipe Title *
                        </label>
                        <input type="text" class="form-control" id="title" name="title" 
                               placeholder="e.g., Classic Chocolate Chip Cookies" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label fw-bold">
                            <i class="bi bi-text-paragraph"></i> Description
                        </label>
                        <textarea class="form-control" id="description" name="description" rows="3"
                                  placeholder="Briefly describe your recipe..."></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="cuisine" class="form-label fw-bold">
                                <i class="bi bi-globe"></i> Cuisine *
                            </label>
                            <select class="form-select" id="cuisine" name="cuisine" required>
                                <option value="">Select a cuisine</option>
                                <% if (cuisines) { cuisines.forEach(cui => { %>
                                    <option value="<%= cui %>"><%= cui %></option>
                                <% }) } %>
                            </select>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="servings" class="form-label fw-bold">
                                <i class="bi bi-people"></i> Servings
                            </label>
                            <input type="number" class="form-control" id="servings" name="servings" 
                                   min="1" max="100" placeholder="e.g., 4">
                        </div>
                    </div>
                </div>

                <!-- Time & Difficulty Section -->
                <div class="form-section">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-clock"></i>
                        </div>
                        <h2 class="section-title">Time & Difficulty</h2>
                    </div>
                    
                    <div class="time-input-group mb-3">
                        <div class="time-input-wrapper">
                            <label for="prep_time_minutes" class="form-label fw-bold">
                                <i class="bi bi-hourglass-split"></i> Prep Time (min)
                            </label>
                            <input type="number" class="form-control" id="prep_time_minutes" 
                                   name="prep_time_minutes" min="0" placeholder="15">
                        </div>
                        
                        <div class="time-input-wrapper">
                            <label for="cook_time_minutes" class="form-label fw-bold">
                                <i class="bi bi-fire"></i> Cook Time (min)
                            </label>
                            <input type="number" class="form-control" id="cook_time_minutes" 
                                   name="cook_time_minutes" min="0" placeholder="30">
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-signal"></i> Difficulty Level
                        </label>
                        <div class="difficulty-options">
                            <div class="difficulty-option">
                                <input type="radio" id="difficulty-easy" name="difficulty" value="Easy">
                                <label class="difficulty-label" for="difficulty-easy">
                                    😊 Easy
                                </label>
                            </div>
                            <div class="difficulty-option">
                                <input type="radio" id="difficulty-medium" name="difficulty" value="Medium">
                                <label class="difficulty-label" for="difficulty-medium">
                                    👨‍🍳 Medium
                                </label>
                            </div>
                            <div class="difficulty-option">
                                <input type="radio" id="difficulty-hard" name="difficulty" value="Hard">
                                <label class="difficulty-label" for="difficulty-hard">
                                    👨‍🔬 Hard
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ingredients Section -->
                <div class="form-section">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-basket"></i>
                        </div>
                        <h2 class="section-title">Ingredients</h2>
                    </div>
                    
                    <div id="ingredients-container">
                        <!-- Initial ingredient input -->
                        <div class="ingredient-item">
                            <input type="text" class="form-control" name="ingredients[]" 
                                   placeholder="e.g., 2 cups all-purpose flour">
                            <button type="button" class="btn btn-remove-ingredient" onclick="removeIngredient(this)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    
                    <button type="button" class="btn btn-add-ingredient mt-2" onclick="addIngredient()">
                        <i class="bi bi-plus-circle"></i> Add Ingredient
                    </button>
                </div>

                <!-- Instructions Section -->
                <div class="form-section">
                    <div class="section-header">
                        <div class="section-icon">
                            <i class="bi bi-list-ol"></i>
                        </div>
                        <h2 class="section-title">Cooking Instructions</h2>
                    </div>
                    
                    <div class="mb-3">
                        <label for="instructions" class="form-label fw-bold">
                            <i class="bi bi-pencil-square"></i> Step-by-step Instructions
                        </label>
                        <textarea class="form-control" id="instructions" name="instructions" rows="8"
                                  placeholder="1. Preheat oven to 350°F (175°C)&#10;2. Mix dry ingredients...&#10;3. ..."></textarea>
                        <small class="text-muted">Write each step on a new line or number them</small>
                    </div>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-submit">
                        <i class="bi bi-check-circle"></i> Create Recipe
                    </button>
                </div>
            </form>
            
            <div class="text-center mt-4">
                <a href="/dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancel & Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <script>
        function addIngredient() {
            const container = document.getElementById('ingredients-container');
            const newItem = document.createElement('div');
            newItem.className = 'ingredient-item';
            newItem.innerHTML = `
                <input type="text" class="form-control" name="ingredients[]" 
                       placeholder="e.g., 1 cup sugar">
                <button type="button" class="btn btn-remove-ingredient" onclick="removeIngredient(this)">
                    <i class="bi bi-trash"></i>
                </button>
            `;
            container.appendChild(newItem);
        }
        
        function removeIngredient(button) {
            const container = document.getElementById('ingredients-container');
            if (container.children.length > 1) {
                button.parentElement.remove();
            } else {
                alert('You must have at least one ingredient field');
            }
        }
    </script>
    
    <!-- Bootstrap JavaScript Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
